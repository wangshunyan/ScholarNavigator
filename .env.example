# ScholarNavigator backend local environment template.
# Copy this file to .env and fill values locally. Do not commit .env.

# OpenAI-compatible LLM provider. Leave disabled for no-LLM local runs.
SCHOLAR_AGENT_LLM_PROVIDER=disabled
SCHOLAR_AGENT_LLM_BASE_URL=https://api.openai.com/v1
SCHOLAR_AGENT_LLM_API_KEY=
SCHOLAR_AGENT_LLM_MODEL=gpt-4.1-mini
SCHOLAR_AGENT_LLM_TIMEOUT_SECONDS=30
SCHOLAR_AGENT_LLM_QUERY_UNDERSTANDING_TIMEOUT_SECONDS=20
SCHOLAR_AGENT_LLM_MAX_TOKENS=1024
SCHOLAR_AGENT_LLM_NVIDIA_THINKING=false

# Optional LLM stages. They require a configured provider and API key.
SCHOLAR_AGENT_ENABLE_LLM_QUERY_UNDERSTANDING=0
SCHOLAR_AGENT_ENABLE_LLM_JUDGEMENT=0
SCHOLAR_AGENT_LLM_JUDGEMENT_BATCH_SIZE=8
SCHOLAR_AGENT_LLM_JUDGEMENT_MAX_PAPERS=8
SCHOLAR_AGENT_LLM_JUDGEMENT_TIMEOUT_SECONDS=25

# Academic connector options.
OPENALEX_MAILTO=
# Optional. Semantic Scholar works without a key but may be more rate-limited.
SEMANTIC_SCHOLAR_API_KEY=

# Bundled local BM25 corpus. It is title-only smoke/evaluation data; complete
# metadata is required before using it as a formal competition corpus.
SCHOLAR_AGENT_LOCAL_BM25_CORPUS=datasets/local_bm25/pasa_papers.jsonl
SCHOLAR_AGENT_LOCAL_BM25_CACHE_DIR=outputs/benchmark_cache/local_bm25
SCHOLAR_AGENT_LOCAL_BM25_DOCUMENT_ID_FIELD=_id
SCHOLAR_AGENT_LOCAL_BM25_TITLE_FIELD=title
SCHOLAR_AGENT_LOCAL_BM25_ABSTRACT_FIELD=abstract
# Use arxiv_id for AutoScholarQuery/PaSa when the paper database exposes arXiv IDs.
SCHOLAR_AGENT_LOCAL_BM25_DOCUMENT_IDENTITY=arxiv_id
# The bundled title-only corpus has no DOI column; set this to `doi` only
# after supplying a metadata-complete corpus.
SCHOLAR_AGENT_LOCAL_BM25_DOI_FIELD=
SCHOLAR_AGENT_LOCAL_BM25_ARXIV_ID_FIELD=arxiv_id
SCHOLAR_AGENT_LOCAL_BM25_SEMANTIC_SCHOLAR_ID_FIELD=semantic_scholar_id
SCHOLAR_AGENT_LOCAL_BM25_S2ORC_CORPUS_ID_FIELD=s2orc_corpus_id
SCHOLAR_AGENT_LOCAL_BM25_OPENALEX_ID_FIELD=openalex_id
SCHOLAR_AGENT_LOCAL_BM25_PUBMED_ID_FIELD=pubmed_id

# Optional local hybrid retrieval.
# Build with scripts/build_pasa_semantic_corpus.py and
# scripts/build_local_hybrid_index.py.
SCHOLAR_AGENT_LOCAL_HYBRID_SEMANTIC_CORPUS=
SCHOLAR_AGENT_LOCAL_HYBRID_INDEX_DIR=outputs/benchmark_cache/local_hybrid
SCHOLAR_AGENT_LOCAL_HYBRID_MODEL=
SCHOLAR_AGENT_LOCAL_HYBRID_BM25_CANDIDATE_LIMIT=60
SCHOLAR_AGENT_LOCAL_HYBRID_SEMANTIC_CANDIDATE_LIMIT=60
SCHOLAR_AGENT_LOCAL_HYBRID_RRF_K=60
SCHOLAR_AGENT_LOCAL_HYBRID_SEMANTIC_SEARCH_MODE=ann
SCHOLAR_AGENT_LOCAL_HYBRID_HNSW_M=32
SCHOLAR_AGENT_LOCAL_HYBRID_HNSW_EF_CONSTRUCTION=80
SCHOLAR_AGENT_LOCAL_HYBRID_HNSW_EF_SEARCH=64
# Optional local neural reranker; leave empty to keep the deterministic rules path.
SCHOLAR_AGENT_LOCAL_HYBRID_RERANKER_MODEL=
SCHOLAR_AGENT_LOCAL_HYBRID_RERANKER_CANDIDATE_LIMIT=120
SCHOLAR_AGENT_LOCAL_HYBRID_RERANKER_BATCH_SIZE=8
SCHOLAR_AGENT_LOCAL_HYBRID_RERANKER_DEVICE=auto

# Real Search runtime options.
SCHOLAR_AGENT_RETRIEVAL_CACHE=1
REAL_SEARCH_MAX_WORKERS=1
REAL_SEARCH_BACKGROUND_WORKERS=2
REAL_SEARCH_RUN_TTL_SECONDS=3600
REAL_SEARCH_MAX_STORED_RUNS=200

# Add custom frontend dev origins if needed. Defaults already include 3000/3001/5173.
SCHOLAR_AGENT_CORS_ORIGINS=

# Hugging Face token for gated datasets or private model access.
HF_TOKEN=
